// Publishes the site (site/public) on the Worker "desktopglow", attached to desktopglow.com and www.desktopglow.com.
// Custom domains: Cloudflare creates the DNS records and the certificate by itself on the first deploy, so the zone
// must not have its own A/AAAA/CNAME for these two names.
// Before deploying: python site/ferramentas/midia.py (the videos are not in git).
// From the desktop-glow folder:   npx wrangler@4 deploy --config site/wrangler.jsonc
// Deploying is his call, every time.
{
  "name": "desktopglow",
  "compatibility_date": "2026-10-01",
  "preview_urls": false,
  "assets": {
    "directory": "./public"
  },
  "routes": [
    { "pattern": "desktopglow.com", "custom_domain": true },
    { "pattern": "www.desktopglow.com", "custom_domain": true }
  ]
}
